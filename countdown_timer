import pygame
import time
pygame.init()


width, height = 800, 400
screen = pygame.display.set_mode((width, height))
pygame.display.set_caption("Countdown Timer")
font = pygame.font.Font(None, 74)


countdown_time = int(input("Enter the countdown time (in seconds): "))
start_time = pygame.time.get_ticks()
running = True 

while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT: 
            running = False

    
    elapsed_time = (pygame.time.get_ticks() - start_time) / 1000  
    remaining_time = max(0, countdown_time - int(elapsed_time))

    
    screen.fill((0, 0, 0))  

   
    time_text = font.render(str(remaining_time), True, (255, 255, 255))
    screen.blit(time_text, (width // 2 - time_text.get_width() // 2, height // 2 - time_text.get_height() // 2))

    
    pygame.display.flip()
    pygame.time.Clock().tick(60)  

    
    if remaining_time == 0:
        running = False

pygame.quit()
